#!/bin/sh
# Enable once: git config core.hooksPath .githooks   (or: scripts/setup-dev.sh)

set -e

cd "$(dirname "$0")/.."

echo "pre-commit: cargo fmt --check"
cargo fmt --check

echo "pre-commit: cargo clippy --all-targets --no-deps -- -D warnings"
cargo clippy --all-targets --no-deps -- -D warnings
